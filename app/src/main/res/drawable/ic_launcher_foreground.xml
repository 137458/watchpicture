<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 朝阳：径向渐变球体，高光偏左上；下缘随后被远山压住形成遮挡景深 -->
    <path android:pathData="M68,46m-11,0a11,11 0,1 1,22 0a11,11 0,1 1,-22 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="64"
                android:centerY="41"
                android:gradientRadius="20">
                <item
                    android:offset="0"
                    android:color="#FFFFF7DC" />
                <item
                    android:offset="0.5"
                    android:color="#FFFFD166" />
                <item
                    android:offset="1"
                    android:color="#FFF59316" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 远山：低饱和半透明，模拟空气透视的退远感；两侧峰体夹住朝阳不遮挡主体 -->
    <path
        android:fillAlpha="0.38"
        android:fillColor="#FFBCD4F7"
        android:pathData="M-8,108 L-8,86 L28,54 L52,78 L82,58 L116,88 L116,108 Z" />
    <!-- 近山：顶部受光、底部沉入阴影的垂直渐变，构成主视觉层的立体台阶 -->
    <path android:pathData="M-8,108 L-8,98 L36,74 L58,90 L78,76 L116,100 L116,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="74"
                android:endX="54"
                android:endY="108">
                <item
                    android:offset="0"
                    android:color="#FFF6FAFF" />
                <item
                    android:offset="0.3"
                    android:color="#FFA8C9F0" />
                <item
                    android:offset="1"
                    android:color="#FF4A7BD0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
